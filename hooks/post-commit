#!/bin/sh
# Record a stamped commit in ClickHouse so it can be joined to its session's spend.
# Runs in the background with a short timeout so a stopped stack never slows a commit.
sid="$(git log -1 --format='%(trailers:key=Agent-Session-Id,valueonly)' | head -n 1)"
[ -n "$sid" ] || exit 0

CH_URL="${AGENT_OTEL_CLICKHOUSE_URL:-http://localhost:8123}"
sha="$(git rev-parse HEAD)"
repo="$(basename "$(git rev-parse --show-toplevel)")"
subject="$(git log -1 --format=%s)"
committed_at="$(git log -1 --format=%cI)"
set -- $(git show --numstat --format= HEAD | awk '{ if ($1 != "-") a += $1; if ($2 != "-") d += $2; f++ } END { print f+0, a+0, d+0 }')

(
  jq -nc --arg sha "$sha" --arg sid "$sid" --arg repo "$repo" --arg subject "$subject" \
    --arg at "$committed_at" --argjson files "$1" --argjson ins "$2" --argjson del "$3" \
    '{sha:$sha, session_id:$sid, repo:$repo, subject:$subject, committed_at:$at, files:$files, insertions:$ins, deletions:$del}' |
  curl -s --max-time 2 --data-binary @- \
    "$CH_URL/?date_time_input_format=best_effort&query=INSERT%20INTO%20otel.agent_commits%20FORMAT%20JSONEachRow" \
    >/dev/null 2>&1
) &
exit 0
